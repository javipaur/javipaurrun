generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RaceType {
  ASFALTO
  MEDIA_MARATON
  MARATON
  TRAIL
  MARCHA
  ORIENTACION
}

enum RaceStatus {
  PROXIMAMENTE
  INSCRIPCIONES_ABIERTAS
  COMPLETADA
  CANCELADA
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String         @default("USER")
  isSubscribed  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  posts         BlogPost[]
  results       RaceResult[]
  reviews       Review[]
  reminders     RaceReminder[]
  memberships   OrganizerMembership[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@id([identifier, token])
}

model Race {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  type          RaceType
  distance      String?
  location      String
  province      String
  date          DateTime
  endDate       DateTime?
  time          String?
  description   String?
  url           String?
  image         String?
  price         String?
  latitude      Float?
  longitude     Float?
  status        RaceStatus     @default(PROXIMAMENTE)
  source        String?
  featured      Boolean        @default(false)
  distanceKm    Float?
  community     String?
  city          String?
  registrationUrl String?
  pendingReview Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  results       RaceResult[]
  reviews       Review[]
  raceReminders RaceReminder[]
  events        Event[]

  @@index([date, province])
  @@index([date, type])
  @@index([community])
  @@index([province, city])
  @@index([pendingReview])
}

model RaceResult {
  id        String   @id @default(cuid())
  raceId    String
  userId    String
  time      String
  hours     Int?
  minutes   Int?
  seconds   Int?
  position  Int?
  category  String?
  notes     String?
  proofUrl  String?
  createdAt DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raceId, userId])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  image     String?
  authorId  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User?    @relation(fields: [authorId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RaceReminder {
  id         String   @id @default(cuid())
  raceId     String
  userId     String
  daysBefore Int      @default(1)
  sent       Boolean  @default(false)
  createdAt  DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raceId, userId])
}

model RaceAlert {
  id         String   @id @default(cuid())
  email      String   @unique
  province   String?
  community  String?
  type       RaceType?
  minKm      Float?
  maxKm      Float?
  active     Boolean  @default(true)
  lastSentAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
  @@index([email])
}

model Review {
  id        String   @id @default(cuid())
  raceId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raceId, userId])
}

model ScrapeLog {
  id        String   @id @default(cuid())
  source    String
  count     Int      @default(0)
  status    String   @default("SUCCESS")
  error     String?
  createdAt DateTime @default(now())
}

enum RunnerStatus {
  REGISTRADO
  EN_CURSO
  FINALIZADO
  NO_PARTIR
  DESCALIFICADO
}

enum PassSource {
  QR
  GEOFENCE
  MANUAL
  RFID
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     OrganizerMembership[]
  events    Event[]
}

model OrganizerMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("ADMIN")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
}

model Event {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  slug           String      @unique
  description    String?
  date           DateTime
  raceId         String?
  route          Json?
  status         String      @default("DRAFT")
  liveOpen       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  race           Race?       @relation(fields: [raceId], references: [id])
  checkpoints    Checkpoint[]
  runners        EventRunner[]
  positions      LivePosition[]
  passes         CheckpointPass[]
}

model Checkpoint {
  id               String           @id @default(cuid())
  eventId          String
  order            Int
  name             String
  km               Float
  lat              Float?
  lng              Float?
  radius           Int              @default(50)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  passes           CheckpointPass[]

  @@unique([eventId, order])
}

model EventRunner {
  id         String       @id @default(cuid())
  eventId    String
  bib        Int
  name       String
  category   String?
  token      String       @unique
  status     RunnerStatus @default(REGISTRADO)
  startTime  DateTime?
  finishTime DateTime?
  createdAt  DateTime     @default(now())
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  positions  LivePosition[]
  passes     CheckpointPass[]

  @@unique([eventId, bib])
}

model LivePosition {
  id        String   @id @default(cuid())
  runnerId  String
  eventId   String
  lat       Float
  lng       Float
  km        Float?
  speed     Float?
  heading   Float?
  createdAt DateTime @default(now())
  runner    EventRunner @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model CheckpointPass {
  id           String     @id @default(cuid())
  runnerId     String
  checkpointId String
  eventId      String
  time         DateTime   @default(now())
  source       PassSource @default(QR)
  runner       EventRunner @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  checkpoint   Checkpoint  @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([runnerId, checkpointId])
}
